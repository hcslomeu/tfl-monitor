# TfL API — get a free key at api-portal.tfl.gov.uk
TFL_APP_KEY=your_tfl_key_here

# Set to "1" to expose /api/v1/debug/tfl/* in the FastAPI Swagger UI so you
# can inspect raw TfL Unified API payloads (line status, yellow banner,
# lift disruptions, arrivals, ...). Local dev only — never enable in prod.
TFL_DEBUG_PROXY=0

# Chat LLM — Anthropic API direct (ADR 015). Issue the key from a dedicated
# Anthropic Console workspace whose monthly spend limit caps the cost.
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional model override; defaults to claude-haiku-5-5.
# CHAT_MODEL=claude-haiku-5-5

# LangSmith observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=tfl-monitor

# Logfire observability
LOGFIRE_TOKEN=your_logfire_token_here
# Optional: override the default head/background sample rate (0.0-1.0).
# Default: 0.1. Warn+ spans and traces longer than 5s are always kept at
# 100% regardless of this value.
# LOGFIRE_SAMPLE_RATE=0.1

# Environment tag for observability
ENVIRONMENT=local
APP_VERSION=0.0.1
